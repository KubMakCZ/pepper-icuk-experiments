<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1a1a2e"
    tools:context=".MainActivity">

    <!-- ========================================================= -->
    <!-- 1. TESTOVACI / ADMIN OBRAZOVKA (Chat, nastaveni, hlasitost) -->
    <!-- ========================================================= -->
    <RelativeLayout
        android:id="@+id/adminContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1a1a2e"
        android:visibility="visible">

        <!-- Spodni input area -->
        <LinearLayout
            android:id="@+id/inputArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:minHeight="68dp"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:background="#0f0f23">

            <Button
                android:id="@+id/btnMic"
                android:layout_width="112dp"
                android:layout_height="56dp"
                android:text="&#x1F3A4; MIC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="#1565C0" />

            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:hint="Napiš zprávu nebo klikni na mikrofon..."
                android:textColorHint="#666680"
                android:textColor="#e0e0e0"
                android:textSize="16sp"
                android:background="#16213e"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="ODESLAT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="#e94560"
                android:paddingStart="18dp"
                android:paddingEnd="18dp" />
        </LinearLayout>

        <!-- Horni status bar + ovladani -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:background="#0f0f23"
            android:padding="8dp">

            <!-- Prvni radek: Stav, model, akcni tlacitka -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="#4CAF50" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Rubby - Připravena"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/spinnerLlm"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="#1a1a4e"
                    android:backgroundTint="#7c7cff"
                    android:popupBackground="#0f0f23"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btnAnimations"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="&#x1F3AD; ANIMACE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="#283593"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="SMAZAT"
                    android:textSize="11sp"
                    android:textColor="#ffffff"
                    android:background="#3d1a1a"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <Button
                    android:id="@+id/btnSwitchToVisitor"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="&#x25B6; PREZENTACE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="#00695C"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <!-- Druhy radek: Velky slider hlasitosti (AudioManager STREAM_MUSIC) + IP adresa dalkoveho ovladani -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="#16213e">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x1F50A; Hlasitost:"
                    android:textColor="#ffffff"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/seekBarVolume"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:max="15" />

                <TextView
                    android:id="@+id/tvVolumePercent"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="80 %"
                    android:textColor="#4FC3F7"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRemoteUrlAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="&#x1F310; Web ovladač: http://...:8080"
                    android:textColor="#81C784"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chat log - vyplni prostor mezi status barem a inputem -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/statusBar"
            android:layout_above="@id/inputArea"
            android:fillViewport="true"
            android:background="#16213e"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvChatLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#c8d6e5"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.4" />
        </ScrollView>
    </RelativeLayout>

    <!-- ========================================================= -->
    <!-- 2. NAVSTEVNICKA / PREZENTACNI OBRAZOVKA (ICUK + stav)      -->
    <!-- ========================================================= -->
    <RelativeLayout
        android:id="@+id/visitorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#102A43"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Horni lista: Nazev ICUK + IP adresa dalkoveho ovladani + prepinani zpet do Admin/Test rezimu -->
        <LinearLayout
            android:id="@+id/visitorHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Inovační centrum Ústeckého kraje (ICUK)"
                android:textColor="#B0BEC5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRemoteUrlVisitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:text="&#x1F310; Web ovladač: http://...:8080"
                android:textColor="#90CAF9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSwitchToAdmin"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="&#x2699; NASTAVENÍ / CHAT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ECEFF1"
                android:background="#263238"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Stredni cast: Logo ICUK + vyrazny stavovy napis -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/visitorHeader"
            android:layout_above="@+id/visitorBottomBar"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <!-- Bile pozadi pod logem ICUK pro perfektni kontrast pri jakekoliv barve pozadi -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivIcukLogo"
                    android:layout_width="280dp"
                    android:layout_height="96dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icuk_logo"
                    android:contentDescription="ICUK Logo" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVisitorStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="&#x25CF; PŘIPRAVENA K ROZHOVORU"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVisitorStateSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Oslov mě jménem „Rubby“, pohlaď mě po hlavě nebo klepni na tlačítko mikrofonu dole!"
                android:textColor="#E0E0E0"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Spodni tlacitka pro navstevniky: Velky mikrofon + Popup s ukazkami animaci -->
        <LinearLayout
            android:id="@+id/visitorBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnVisitorMic"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="&#x1F3A4;  MLUVIT S RUBBY"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#1565C0" />

            <Button
                android:id="@+id/btnVisitorAnimations"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:text="&#x1F3AD;  CO VŠECHNO UMÍM?"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#6A1B9A"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
